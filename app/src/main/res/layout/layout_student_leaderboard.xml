<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mc_leader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Status ribbon -->
        <LinearLayout
            android:id="@+id/ll_result_status"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:background="@drawable/red_left_corner_background">

            <TextView
                android:id="@+id/tv_result_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:gravity="center"
                android:text="F\nA\nI\nL"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="3.5">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".5"
                    android:text="Date : "
                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/attempt_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="24/08/2024"
                    android:textColor="@color/onSurface"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:padding="1dp"
                    android:text="Completed in :"
                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/completedIn_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".8"
                    android:padding="1dp"
                    android:text="02:56 hrs"
                    android:textColor="@color/onSurface"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="6dp"
                android:alpha="0.2"
                android:background="@color/gold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".55"
                    android:text="Appear by : "
                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/appear_by"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.45"
                    android:text="Rohit Pandit"
                    android:textColor="@color/onSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".55"
                    android:text="Subject : "
                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/subject_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.45"
                    android:ellipsize="end"
                    android:text="Computer Application"
                    android:textColor="@color/onSurface"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:weightSum="2.3">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pr_markScored"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:max="50"
                    android:progress="20"
                    app:indicatorColor="@color/accent"
                    app:trackColor="@color/progress_track"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="6dp" />

                <TextView
                    android:id="@+id/tv_exam_mark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight=".5"
                    android:text="20/50"
                    android:textColor="@color/onSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_view_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".3"
                    android:paddingStart="5dp"
                    android:text="View"
                    android:textColor="@color/bluetint"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>