<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- Header row: Subject + Date badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/subject_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Computer Application"
                android:textColor="@color/onSurface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/host_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_surface_variant"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="00/00/0000"
                android:textColor="@color/onSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.4"
            android:background="@color/outline" />

        <!-- Hosted by -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hosted by"
                android:textColor="@color/onSurfaceVariant"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/user_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Rohit Pandit"
                android:textColor="@color/onSurface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/full_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Mark : 00"
                android:textColor="@color/onSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Exam Availability & Questions -->
        <LinearLayout
            android:id="@+id/ll_exam_availability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/box_outline"
            android:backgroundTint="@color/blue_bg"
            android:orientation="vertical"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/full_mark">

            <TextView
                android:id="@+id/tv_availability_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available: 24/08/2024 (10:00 AM) - 25/08/2024 (10:00 AM)"
                android:textColor="@color/bluetint"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_total_questions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Questions: 00"
                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_time_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time Left: --"
                    android:textColor="@color/error"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Start Exam button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_exam_btn"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:text="Start Exam"
            android:textColor="@color/primary"
            app:backgroundTint="@color/onPrimary"
            app:cornerRadius="14dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>