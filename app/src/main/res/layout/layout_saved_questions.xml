<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_save_question"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="5dp"
    android:layout_marginBottom="10dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- Top Header Row: Subject Badge & Delete Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Subject Chip / Pill -->
            <TextView
                android:id="@+id/subject_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_surface_variant"
                android:backgroundTint="@color/cyan_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/cyantint"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="English" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Delete Action Icon Button -->
            <ImageButton
                android:id="@+id/iv_delete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_surface"
                android:backgroundTint="@color/red_bg"
                android:contentDescription="Delete question"
                android:src="@drawable/baseline_delete_24"
                android:padding="8dp"
                app:tint="@color/redtint" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:alpha="0.15"
            app:dividerColor="@color/cyantint" />

        <!-- Question Label Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="Question"
            android:textAllCaps="true"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Question Body Text -->
        <TextView
            android:id="@+id/question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/onSurface"
            android:textSize="14sp"
            tools:text="Select the most appropriate synonym for the word 'ABUNDANT' from the given options." />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>