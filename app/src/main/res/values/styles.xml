<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_variant</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Toolbar Style -->
    <style name="CustomToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/onPrimary</item>
        <item name="subtitleTextColor">@color/text_hint</item>
    </style>

    <!-- Custom SearchView Theme -->
    <style name="CustomSearchViewTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@color/onPrimary</item>
        <item name="colorControlActivated">@color/onPrimary</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:queryBackground">@android:color/transparent</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>